<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is permitted ONLY to the Windows host inside WireGuard.
     All other HTTP endpoints remain blocked in release builds. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain>10.77.0.1</domain>
    </domain-config>
</network-security-config>
